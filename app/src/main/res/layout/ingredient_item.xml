<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="@color/white">

    <!-- Ingredient Name -->
    <TextView
        android:id="@+id/tvIngredientName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@+id/btnDelete"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black" />

    <!-- Quantity and Unit -->
    <TextView
        android:id="@+id/tvQuantityUnit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvIngredientName"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@+id/btnDelete"
        android:textSize="14sp"
        android:textColor="@color/text_secondary" />

    <!-- Delete Button -->
    <ImageButton
        android:id="@+id/btnDelete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:src="@drawable/ic_delete"
        android:background="?attr/selectableItemBackground"
        android:scaleType="centerInside"
        android:contentDescription="@string/btn_delete_ingredient" />

    <!-- Edit Button -->
    <ImageButton
        android:id="@+id/btnEdit"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_toStartOf="@+id/btnDelete"
        android:layout_alignParentTop="true"
        android:src="@drawable/ic_edit"
        android:background="?attr/selectableItemBackground"
        android:scaleType="centerInside"
        android:contentDescription="@string/btn_edit_ingredient" />

    <!-- Add Button -->
    <ImageButton
        android:id="@+id/btnAdd"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_toStartOf="@+id/btnEdit"
        android:layout_alignParentTop="true"
        android:src="@drawable/ic_add"
        android:background="?attr/selectableItemBackground"
        android:scaleType="centerInside"
        android:contentDescription="@string/btn_add_ingredient" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@+id/tvQuantityUnit"
        android:layout_marginTop="8dp"
        android:background="@color/divider_color" />

</RelativeLayout>

