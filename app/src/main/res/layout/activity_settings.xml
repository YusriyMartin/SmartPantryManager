<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/Settings"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Unit preference section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/change_unit_of_measure"
            android:textSize="16sp"
            android:textColor="#BBBBBB" />

        <Spinner
            android:id="@+id/spinnerPref"
            android:layout_width="120dp"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:theme="@style/ThemeOverlay.AppCompat.Dark" />

        <!-- Expiry notification section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/see_expiry_dates"
            android:textSize="16sp"
            android:textColor="#BBBBBB" />

        <!--Radio buttons container for unit of measure and expiry-->
        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbYes"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:text="@string/yes"
                android:textSize="16sp"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/rbNo"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="24dp"
                android:text="@string/no"
                android:textSize="16sp"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <!--Save button -->
        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            android:text="@string/save_settings"
            android:textSize="16sp"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
