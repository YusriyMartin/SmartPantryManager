<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title: "Add/Edit Ingredient" -->
    <TextView
        android:id="@+id/tvAddEditTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Ingredient"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Ingredient Name Input Field -->
    <EditText
        android:id="@+id/etIngredientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingredient Name (e.g., Tomato)"
        android:inputType="text"
        android:layout_marginBottom="16dp"
        android:padding="12dp" />

    <!-- Quantity Input Field -->
    <EditText
        android:id="@+id/etQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quantity (e.g., 2.5)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="16dp"
        android:padding="12dp" />

    <!-- Unit Spinner Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Unit of Measurement"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <!-- Unit Spinner (Dropdown) -->
    <Spinner
        android:id="@+id/spinnerUnit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:padding="12dp" />

    <!-- Save Button -->
    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Ingredient"
        android:textSize="16sp"
        android:layout_marginBottom="8dp" />

    <!-- Cancel Button -->
    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:textSize="16sp" />

</LinearLayout>
