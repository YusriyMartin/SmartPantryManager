<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="12dp">

    <!-- Weclome message green border -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/hey_there_chef_here_s_a_look_at_all_the_recipes_you_can_cook_today_based_on_your_available_ingredients"
        android:textColor="#4CAF50"
        android:padding="12dp"
        android:background="@drawable/green_border"/>

    <!-- Recipe list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"/>

    <!-- Shown when no recipes match pantry -->
    <TextView
        android:id="@+id/txtNoMatch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_recipes_match_your_pantry_yet_add_more_ingredients"
        android:textColor="#FFF"
        android:gravity="center"
        android:visibility="gone"
        android:padding="24dp"/>

    <!-- Back button -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/back_to_home"/>

</LinearLayout>
